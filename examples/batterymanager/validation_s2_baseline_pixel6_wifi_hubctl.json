{
  "_comment": "S2 Baseline on Pixel 6 over WiFi-ADB with auto hub-ctrl. Pixel 6 is on inner hub 5-1.3.2.1 port 4 (post-2026-06-02 topology). First Pixel 6 measurement of this thesis. Run: cd android-runner && source .venv/bin/activate && python3 . examples/batterymanager/validation_s2_baseline_pixel6_wifi_hubctl.json",
  "type": "native",
  "adb_path": "/home/irena/Android/Sdk/platform-tools/adb",
  "devices": {
    "Pixel 6-W": {}
  },
  "repetitions": 1,
  "interaction_covers_duration": true,
  "paths": [
    "/home/irena/Documents/Master Experiment/_external/android-apps-benchmark/APKs/Baseline/e.www.baseline.apk"
  ],
  "application_id": "e.www.baseline",
  "duration": 60000,
  "usb_handler": {
    "enable_command": "sudo -n /usr/sbin/uhubctl -l 3-6.1 -p 4 -a 1",
    "disable_command": "sudo -n /usr/sbin/uhubctl -l 3-6.1 -p 4 -a 0"
  },
  "profilers": {
    "batterymanager": {
      "experiment_aggregation": "default",
      "sample_interval": 100,
      "data_points": [
        "BATTERY_PROPERTY_CURRENT_NOW",
        "BATTERY_PROPERTY_STATUS",
        "EXTRA_VOLTAGE"
      ],
      "persistency_strategy": [
        "adb_log"
      ]
    },
    "android": {
      "sample_interval": 1000,
      "data_points": [
        "cpu",
        "mem"
      ]
    }
  },
  "scripts": {
    "before_experiment": "Scripts/before_experiment_uninstall_s2_baseline.py",
    "before_run": "Scripts/before_run.py",
    "after_launch": "Scripts/after_launch.py",
    "interaction": "Scripts/interaction_s2_baseline.py",
    "before_close": "Scripts/before_close.py",
    "after_run": "Scripts/after_run.py",
    "after_experiment": "Scripts/after_experiment.py"
  },
  "time_between_run": 5000
}